# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Model weights (downloaded on first run / into the models cache)
models/
*.pt
*.pth
*.onnx

# Cached pipeline results
*.reidcache
.cache/

# Run logs
logs/

# Labeled training pairs exported from the GUI
training_data/

# Remembered GUI settings (folders, sliders, device, ...)
settings.json

# Sample / large media. The ** matters: a plain `samples/*.jpg` only matches
# files directly in samples/, so frames sitting in the per-point subfolders
# the extractor creates (samples/A/A1_frames_A/*.jpg) slipped past it and ~1 GB
# of them ended up committed. Keep these patterns recursive.
samples/**/*.jpg
samples/**/*.jpeg
samples/**/*.png
samples/**/*.bmp
samples/**/*.webp
samples/**/*.mp4
samples/**/*.avi
samples/**/*.mov
samples/**/*.mkv
# OCR timestamp sidecars belong to those frames, not in the repo.
samples/**/.timestamps.json
!samples/README.md

# OS / editor
.DS_Store
.idea/
.vscode/
